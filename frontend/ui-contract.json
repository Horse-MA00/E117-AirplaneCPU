{
 "_说明": "前端 UI 重构的冻结约定，规则见 docs/FRONTEND_UI.md。改布局可以移动这些元素，但不能删除或改名；确需改动时，在同一个提交里同步修改 JS、smoke 测试和本文件。tests/test_frontend_contract.py 会检查。",
 "pages": {
  "/admin": {
   "html": "frontend/index.html",
   "routes": [
    "flights",
    "optimization",
    "pricing",
    "customers",
    "market",
    "members"
   ],
   "route_mechanism": "location.hash 选择 section#view-<route>.view，其余 section 设为 hidden"
  },
  "/members": {
   "html": "frontend/members/index.html",
   "routes": [
    "flights",
    "membership",
    "trips",
    "account"
   ],
   "route_mechanism": "同一长页面内的锚点；dialog#checkout 是订票弹窗"
  }
 },
 "api": [
  {
   "method": "GET",
   "path": "/api/summary",
   "used_by": [
    "app.js",
    "optimization.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/flights",
   "used_by": [
    "app.js",
    "optimization.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/flights/{flight_id}",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/forecast",
   "used_by": [
    "app.js"
   ],
   "body": [
    "flight_id",
    "days_to_departure"
   ]
  },
  {
   "method": "POST",
   "path": "/api/optimize",
   "used_by": [
    "app.js"
   ],
   "body": [
    "flight_id",
    "days_to_departure",
    "config.membership_days",
    "config.customers",
    "config.incremental_cost",
    "config.ancillary_margin",
    "config.seed"
   ]
  },
  {
   "method": "GET",
   "path": "/api/optimization/suggestions?flight_id=&day=",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/optimization/runs",
   "used_by": [
    "optimization.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/optimization/runs",
   "used_by": [
    "optimization.js"
   ],
   "body": [
    "rounds",
    "customers",
    "replicates",
    "seed",
    "release_fraction",
    "min_service_rate",
    "program_cost",
    "fare_min",
    "flight_id",
    "forecast_day",
    "mode",
    "max_calls",
    "total_live_budget"
   ]
  },
  {
   "method": "GET",
   "path": "/api/optimization/runs/{run_id}",
   "used_by": [
    "optimization.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/optimization/runs/{run_id}/resume",
   "used_by": [
    "optimization.js"
   ],
   "body": [
    "max_calls",
    "additional_live_budget"
   ]
  },
  {
   "method": "LINK",
   "path": "/api/optimization/runs/{run_id}/export",
   "used_by": [
    "optimization.js"
   ]
  },
  {
   "method": "LINK",
   "path": "/api/optimization/runs/{run_id}/events",
   "used_by": [
    "optimization.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/optimization/initial-policy",
   "used_by": [
    "optimization.js"
   ],
   "body": [
    "flight_id",
    "forecast_day",
    "customers",
    "program_cost"
   ]
  },
  {
   "method": "POST",
   "path": "/api/pricing/runs",
   "used_by": [
    "continuous.js"
   ],
   "body": [
    "price_min",
    "price_max",
    "membership_fee",
    "release_fraction",
    "evaluations"
   ]
  },
  {
   "method": "GET",
   "path": "/api/pricing/runs/{run_id}",
   "used_by": [
    "continuous.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/personas",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/agents/panels",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/agents/panels",
   "used_by": [
    "app.js"
   ],
   "body": [
    "mode",
    "count",
    "member_fare",
    "membership_fee",
    "seed",
    "max_calls"
   ]
  },
  {
   "method": "GET",
   "path": "/api/agents/panels/{run_id}",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/agents/panels/{run_id}/people/{customer_id}",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/agents/panels/{run_id}/resume",
   "used_by": [
    "app.js"
   ],
   "body": [
    "max_calls"
   ]
  },
  {
   "method": "GET",
   "path": "/api/agents/runs",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "LINK",
   "path": "/api/agents/runs/{run_id}/export",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/market/runs",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/market/runs",
   "used_by": [
    "app.js"
   ],
   "body": [
    "mode",
    "seed",
    "member_fare",
    "membership_fee",
    "release_fraction",
    "max_calls"
   ]
  },
  {
   "method": "GET",
   "path": "/api/market/runs/{run_id}",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/market/runs/{run_id}/cases/{case_id}",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/market/runs/{run_id}/resume",
   "used_by": [
    "app.js"
   ],
   "body": [
    "max_calls"
   ]
  },
  {
   "method": "GET",
   "path": "/api/offers",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/offers",
   "used_by": [
    "app.js"
   ],
   "body": [
    "flight_id",
    "days_to_departure",
    "quantity",
    "base_fare",
    "optimization_run_id?",
    "optimization_mode?"
   ]
  },
  {
   "method": "GET",
   "path": "/api/member-portal/plan",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/member-portal/plan",
   "used_by": [
    "app.js"
   ],
   "body": [
    "membership_fee"
   ]
  },
  {
   "method": "GET",
   "path": "/api/member-portal/config",
   "used_by": [
    "members/portal.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/member-portal/flights",
   "used_by": [
    "members/portal.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/member-portal/accounts/{customer_id}",
   "used_by": [
    "members/portal.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/member-portal/join",
   "used_by": [
    "members/portal.js"
   ],
   "body": [
    "customer_id",
    "expected_fee"
   ]
  },
  {
   "method": "POST",
   "path": "/api/member-portal/book",
   "used_by": [
    "members/portal.js"
   ],
   "body": [
    "customer_id",
    "offer_id",
    "expected_total"
   ]
  }
 ],
 "events": {
  "uoption:view": "app.js 切换页面后发出，detail.name 为路由名",
