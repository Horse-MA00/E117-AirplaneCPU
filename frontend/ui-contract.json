{
 "_说明": "前端 UI 重构的冻结约定，规则见 docs/FRONTEND_UI.md。改布局可以移动这些元素，但不能删除或改名；确需改动时，在同一个提交里同步修改 JS、smoke 测试和本文件。tests/test_frontend_contract.py 会检查。",
 "pages": {
  "/admin": {
   "html": "frontend/index.html",
   "routes": [
    "flights",
    "members",
    "results",
    "customers"
   ],
   "route_mechanism": "location.hash 选中 section#view-<route>.view；#results 为 2026-11-15 新增；未知或已退役的 hash（#optimization、#pricing、#panel、#market）显示 section#view-unavailable，不跳转。search#context-bar 是 flights/members/results 共用的航班选择栏"
  },
  "/adaptive-pricing": {
   "html": "frontend/adaptive-pricing.html",
   "routes": [],
   "route_mechanism": "独立页面（Optimize）。网址参数 flight_id、forecast_day、run、round 恢复航班、轮次和已保存实验；没有 run 时自动打开该航班和轮次最近一次已完成的实验"
  },
  "/members": {
   "html": "frontend/members/index.html",
   "routes": [
    "flights",
    "membership",
    "trips",
    "account"
   ],
   "route_mechanism": "同一长页面内的锚点；dialog#checkout 是订票弹窗"
  }
 },
 "api": [
  {
   "method": "GET",
   "path": "/api/summary",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/flights",
   "used_by": [
    "app.js",
    "adaptive-pricing.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/flights/{flight_id}",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/forecast",
   "used_by": [
    "app.js"
   ],
   "body": [
    "flight_id",
    "days_to_departure"
   ]
  },
  {
   "method": "GET",
   "path": "/api/offers",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/offers",
   "used_by": [
    "app.js"
   ],
   "body": [
    "flight_id",
    "days_to_departure",
    "quantity",
    "base_fare"
   ]
  },
  {
   "method": "GET",
   "path": "/api/member-portal/plan",
   "used_by": [
    "app.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/member-portal/plan",
   "used_by": [
    "app.js"
   ],
   "body": [
    "membership_fee"
   ]
  },
  {
   "method": "GET",
   "path": "/api/adaptive-pricing/status",
   "used_by": [
    "adaptive-pricing.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/adaptive-pricing/scope",
   "used_by": [
    "adaptive-pricing.js"
   ],
   "body": [
    "flight_id",
    "forecast_day",
    "profile"
   ]
  },
  {
   "method": "GET",
   "path": "/api/adaptive-pricing/runs",
   "used_by": [
    "adaptive-pricing.js",
    "experiments.js",
    "app.js（Publish 页的 Thompson 参考，只读）"
   ]
  },
  {
   "method": "POST",
   "path": "/api/adaptive-pricing/runs",
   "used_by": [
    "adaptive-pricing.js"
   ],
   "body": [
    "flight_id",
    "forecast_day",
    "mode",
    "profile",
    "weights",
    "rounds",
    "customers",
    "concurrency",
    "max_calls",
    "seed",
    "validation_repeats"
   ]
  },
  {
   "method": "GET",
   "path": "/api/adaptive-pricing/runs/{run_id}",
   "used_by": [
    "adaptive-pricing.js",
    "experiments.js"
   ]
  },
  {
   "method": "LINK",
   "path": "/api/adaptive-pricing/runs/{run_id}/export",
   "used_by": [
    "adaptive-pricing.js",
    "experiments.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/member-portal/config",
   "used_by": [
    "members/portal.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/member-portal/flights",
   "used_by": [
    "members/portal.js"
   ]
  },
  {
   "method": "GET",
   "path": "/api/member-portal/accounts/{customer_id}",
   "used_by": [
    "members/portal.js"
   ]
  },
  {
   "method": "POST",
   "path": "/api/member-portal/join",
   "used_by": [
    "members/portal.js"
   ],
   "body": [
    "customer_id",
    "expected_fee"
   ]
  },
  {
   "method": "POST",
   "path": "/api/member-portal/book",
   "used_by": [
    "members/portal.js"
   ],
   "body": [
    "customer_id",
    "offer_id",
    "expected_total"
   ]
  }
 ],
 "events": {
  "uoption:view": "app.js 切换页面后发出，experiments.js 据此在 #customers 读取已保存实验"
 },
 "url_and_storage": {
  "/adaptive-pricing?flight_id=&forecast_day=": "Forecast 和 Manage offers 打开 Optimize 时带入航班和放票轮次（thompson-navigation.js）",
  "/adaptive-pricing?run=&round=": "恢复已保存的 Thompson 实验和轮次",
  "/admin?run=&round=#customers": "Experiments 分享指定实验和轮次的会员回馈",
  "localStorage['uoption-member-demo-account']": "会员端的演示账号 ID",
  "/admin?flight_id=&forecast_day=#<route>": "Optimize 的侧边栏和 \"Publish at HK$…\" 按钮把当前航班和轮次带回 Admin（app.js 在 init 中读取）"
 },
